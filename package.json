{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "nuxt build --preset github_pages",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "publish": "bunx gh-pages --dotfiles -d .output/public",
    "postinstall": "nuxt prepare",
    "changelog": "changelogen --release",
    "clean": "nuxi cleanup && bun run postinstall",
    "lighthouse": "unlighthouse",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix ."
  },
  "dependencies": {
