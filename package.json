    "@nuxtjs/seo": "3.1.0",
    "@octokit/rest": "^22.0.0",
    "@pinia/nuxt": "0.11.2",
    "@tailwindcss/typography": "^0.5.16",
    "@vueuse/components": "^13.6.0",
    "@vueuse/core": "^13.6.0",
    "@vueuse/integrations": "^13.6.0",
    "@vueuse/nuxt": "^13.6.0",
    "@vueuse/router": "^13.6.0",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "motion-v": "^1.7.0",
