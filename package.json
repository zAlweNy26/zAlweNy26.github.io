    "@tailwindcss/typography": "^0.5.20",
    "@takumi-rs/core": "^2.14.0",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "nuxt": "^4.5.2",
    "nuxt-vitalizer": "3.0.0",
    "rehype-external-links": "^3.0.0",
    "rehype-stringify": "^10.0.1",
