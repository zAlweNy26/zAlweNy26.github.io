    "@nuxtjs/seo": "3.2.2",
    "@octokit/rest": "^22.0.1",
    "@tailwindcss/typography": "^0.5.19",
    "@vueuse/components": "^14.0.0",
    "@vueuse/core": "^14.0.0",
    "@vueuse/integrations": "^14.0.0",
    "@vueuse/nuxt": "^14.0.0",
    "@vueuse/router": "^14.0.0",
    "motion-v": "^1.7.4",
